<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LTAMacho" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/aqua</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar & Navigation bar -->
        <item name="android:statusBarColor">@color/primary_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <style name="Theme.LTAMacho" parent="Base.Theme.LTAMacho" />
</resources>