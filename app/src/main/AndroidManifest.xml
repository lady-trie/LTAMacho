<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="WashTrack"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LTAMacho"
        android:usesCleartextTraffic="true">

        <!-- SplashScreenActivity sebagai Launcher Utama -->
        <activity
            android:name=".pertemuan6.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".pertemuan6.AuthActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan6.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan6.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan6.VerificationActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".BaseActivity"
            android:exported="false" />

        <activity
            android:name=".DeveloperProfileActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan_5.WebViewActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan_3.ThirdResultActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan_3.ThirdActivity"
            android:exported="false" />

    </application>

</manifest>